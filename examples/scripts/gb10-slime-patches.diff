+                        or _p_ckpt.total_memory >= 0.9 * _ps_ckpt.virtual_memory().total))
+    args.use_persistent_ckpt_worker = not _unified_mem
+    import logging as _lg_ckpt
+    _lg_ckpt.getLogger(__name__).warning(f'[CKPT-UNIFIED] unified_mem={_unified_mem} use_persistent_ckpt_worker={args.use_persistent_ckpt_worker}')
