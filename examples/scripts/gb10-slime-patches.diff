     # Checkpoint I/O defaults: these keep checkpoint contents unchanged while
     # reducing repeated validation/planning work and parallelizing load.
-    args.use_persistent_ckpt_worker = True
+    # UNIFIED-MEMORY FIX: the persistent-ckpt-worker stages the full checkpoint GPU->Host
+    # for a background writer; on GB10/Grace-Blackwell that host copy shares the SAME
+    # physical pool as the GPU tensors, doubling the checkpoint footprint and OOMing the
+    # save. Detect unified memory and save in-process (sync) there; keep async on discrete.
+    import torch as _t_ckpt, psutil as _ps_ckpt
+    _p_ckpt = _t_ckpt.cuda.get_device_properties(0) if _t_ckpt.cuda.is_available() else None
