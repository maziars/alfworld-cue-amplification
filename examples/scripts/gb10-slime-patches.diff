+class _TensorBackuperMasterActor(TensorBackuper):
+    """Hybrid backuper for the master-param trick.
+
+    The `master_tag` (the trainable actor) is VIRTUAL: no pinned CPU backup is kept. Its
+    bf16 weights are reconstructed on demand from the always-resident fp32 optimizer master
+    via `restore_master_fn` (deterministic fp32->bf16 cast => bit-identical to the
+    pre-excursion actor, since the ref forward is forward-only so the master is unchanged).
+    All other tags (e.g. "ref") keep real pinned backups. Saves one full model backup
+    (~7.83 GiB for 4B) when KL/ref is enabled, with no training-math change. task #12.
+    """
+
+    def __init__(self, source_getter, master_tag, restore_master_fn):
+        super().__init__(source_getter=source_getter)
+        self._master_tag = master_tag
+        self._restore_master_fn = restore_master_fn
+        self._inner = _TensorBackuperNormal(source_getter=source_getter)
+        self._master_hash_dict = None  # lightweight safety guard, not a real backup
+
+    @property
+    def backup_tags(self):
+        return [self._master_tag] + self._inner.backup_tags
+
+    def get(self, tag: str):
+        if tag == self._master_tag:
+            ans = {k: v.detach() for k, v in dict(self._source_getter()).items()}
+            if self._master_hash_dict is not None:
+                assert _compute_hash_dict(ans) == self._master_hash_dict, (
+                    "master-param trick: live model != last actor backup at get()"
+                )
+            return ans
+        return self._inner.get(tag)
+
+    def backup(self, tag: str) -> None:
+        if tag == self._master_tag:
+            self._master_hash_dict = _compute_hash_dict(dict(self._source_getter()))
+            torch.cuda.synchronize()
+            return
+        self._inner.backup(tag)
+
+    def copy(self, *, src_tag: str, dst_tag: str):
+        assert self._master_tag not in (src_tag, dst_tag), "cannot copy to/from virtual master tag"
+        self._inner.copy(src_tag=src_tag, dst_tag=dst_tag)
+
+    def restore(self, tag: str) -> None:
+        if tag == self._master_tag:
+            self._restore_master_fn()
+            if self._master_hash_dict is not None:
+                assert _compute_hash_dict(dict(self._source_getter())) == self._master_hash_dict, (
+                    "master-param trick: rebuilt actor != last actor backup at restore()"
+                )
+            torch.cuda.synchronize()
+            return
+        self._inner.restore(tag)
+
+
 def _compute_hash_dict(tensors: dict[str, torch.Tensor]):
     return {k: _compute_hash_tensor(v) for k, v in tensors.items()}
 
